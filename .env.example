# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# remove.bg -> dashboard -> API key
REMOVE_BG_API_KEY=

# Paystack -> dashboard -> Settings -> API Keys & Webhooks
# Secret key is server-only — never expose it to the browser.
PAYSTACK_SECRET_KEY=

# Admin login (simple, single-admin — see README for why)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Random long string used to sign the admin session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
